{
  "name": "dream-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dream Arena — agent-first prediction markets on Somnia (Somnia x DreamDEX Event Contracts)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:fault": "vitest run --project fault",
    "test:all": "vitest run",
    "ci": "npm run typecheck && npm run test && npm run test:web && npm run test:integration && npm run test:fault",
    "gate:0": "node packages/ops/scripts/gate-g0.mjs",
    "agent": "node --experimental-strip-types packages/ops/src/main.ts",
    "test:web": "vitest run --project web",
    "fund": "node --env-file-if-exists=.env packages/ops/scripts/fund.mjs",
    "test:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project live",
    "smoke:live": "node --env-file-if-exists=.env packages/ops/scripts/live-roundtrip.mjs",
    "probe:markets": "node --env-file-if-exists=.env packages/ops/scripts/probe-markets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.29.0",
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  }
}
